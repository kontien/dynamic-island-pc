                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="🧹 RAM" Style="{StaticResource ChipButton}" Margin="0,0,4,0" Click="FreeRam_Click"/>
                                    <Button Grid.Column="1" Content="☀️ ЯРКОСТЬ" Style="{StaticResource ChipButton}" Margin="2,0,4,0" Click="BrightnessBtn_Click"/>
                                    <Button Grid.Column="2" Content="🌙 НОЧЬ" Style="{StaticResource ChipButton}" Margin="2,0,0,0" Click="NightLightBtn_Click"/>
                                </Grid>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="ТОП CPU" FontSize="9" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,6"/>
                                            <StackPanel x:Name="CpuProcessStack"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="ТОП RAM" FontSize="9" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,6"/>
                                            <StackPanel x:Name="RamProcessStack"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>