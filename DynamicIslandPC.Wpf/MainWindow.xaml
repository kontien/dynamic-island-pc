                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock x:Name="SmallOsdAppName" Text="Система" FontSize="10" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar x:Name="SmallOsdProgress" Minimum="0" Maximum="100" Value="50" Height="4" Foreground="{DynamicResource AccentColor}" Background="{DynamicResource Track}" BorderThickness="0" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="SmallOsdPercentText" Grid.Column="2" Text="50%" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid x:Name="LargeOsd" Margin="22,0,22,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LargeOsdIcon" Text="🔊" FontSize="34" FontFamily="{StaticResource EmojiFont}" VerticalAlignment="Center" Margin="0,0,22,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,22,0">
                                <TextBlock x:Name="LargeOsdAppName" Text="Система" FontSize="15" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                                <ProgressBar x:Name="LargeOsdProgress" Minimum="0" Maximum="100" Value="50" Height="10" Foreground="{DynamicResource AccentColor}" Background="{DynamicResource Track}" BorderThickness="0"/>
                            </StackPanel>
                            <TextBlock x:Name="LargeOsdPercentText" Grid.Column="2" Text="50%" FontSize="40" FontWeight="SemiBold" FontFamily="{StaticResource IslandFont}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>

                    <!-- PEEK УВЕДОМЛЕНИЯ -->
                    <Grid x:Name="NotifOsd" Grid.Row="0" Height="44" Visibility="Collapsed" Opacity="0" Panel.ZIndex="46"
                          Background="{DynamicResource IslandBgGrad}">
                        <Grid Margin="16,0,16,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock x:Name="NotifOsdIcon" Text="🔔" FontSize="15" FontFamily="{StaticResource EmojiFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="NotifOsdLogo" Width="18" Height="18" Stretch="Uniform" Visibility="Collapsed"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="NotifOsdApp" Text="" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="NotifOsdTitle" Text="" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                <TextBlock x:Name="NotifOsdBody" Text="" FontSize="9" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock x:Name="NotifOsdTime" Grid.Column="2" Text="" FontSize="9" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </Grid>

                    <!-- ДОСКА 4×5 -->
                    <Grid x:Name="BoardGrid" Grid.Row="1" ClipToBounds="True" Margin="6,0,6,6" Visibility="Collapsed" Opacity="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="TileMedia" Style="{StaticResource TileBorder}" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" MouseLeftButtonUp="TileMedia_Click">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource TileTitle}" Text="СЕЙЧАС ИГРАЕТ"/>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="PlayerCoverBorder" Width="42" Height="42" CornerRadius="6" Background="#663A3A44" Margin="0,0,10,0">
                                        <TextBlock x:Name="PlayerCoverText" Text="🎵" FontSize="19" FontFamily="{StaticResource EmojiFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="PlayerTitleText" Text="Нет трека" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="PlayerArtistText" Text="YouTube / Spotify" FontSize="10" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="PrevBtn" Style="{StaticResource MediaButton}" Width="28" Height="28" FontSize="11" Content="&#xE892;" Click="Prev_Click"/>
                                        <Button x:Name="PlayPauseBtn" Style="{StaticResource MediaButton}" Width="28" Height="28" FontSize="12" Content="&#xE768;" Click="PlayPause_Click"/>
                                        <Button x:Name="NextBtn" Style="{StaticResource MediaButton}" Width="28" Height="28" FontSize="11" Content="&#xE893;" Click="Next_Click"/>
                                    </StackPanel>
                                </Grid>
                                <Grid x:Name="TimelineGrid" Grid.Row="2" Margin="0,6,0,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TimelineCurrentText" Text="0:00" FontSize="9" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" Margin="0,0,6,0"/>
