                                    <StackPanel x:Name="EqBars" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Height="14">
                                        <Rectangle Width="2.5" Fill="{DynamicResource AccentColor}" RadiusX="1" RadiusY="1" Margin="1,0" Height="5"/>
                                        <Rectangle Width="2.5" Fill="{DynamicResource AccentColor}" RadiusX="1" RadiusY="1" Margin="1,0" Height="9"/>
                                        <Rectangle Width="2.5" Fill="{DynamicResource AccentColor}" RadiusX="1" RadiusY="1" Margin="1,0" Height="12"/>
                                        <Rectangle Width="2.5" Fill="{DynamicResource AccentColor}" RadiusX="1" RadiusY="1" Margin="1,0" Height="7"/>
                                        <Rectangle Width="2.5" Fill="{DynamicResource AccentColor}" RadiusX="1" RadiusY="1" Margin="1,0" Height="10"/>
                                        <Rectangle Width="2.5" Fill="{DynamicResource AccentColor}" RadiusX="1" RadiusY="1" Margin="1,0" Height="6"/>
                                        <Rectangle Width="2.5" Fill="{DynamicResource AccentColor}" RadiusX="1" RadiusY="1" Margin="1,0" Height="9"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border x:Name="TileClip" Style="{StaticResource TileBorder}" Grid.Column="2" Grid.Row="0" Grid.ColumnSpan="2" MouseLeftButtonUp="TileClip_Click">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource TileTitle}" Text="БУФЕР ОБМЕНА"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="ClipboardStack"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border x:Name="TileVol" Style="{StaticResource TileBorder}" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" MouseLeftButtonUp="TileVol_Click">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource TileTitle}" Text="ГРОМКОСТЬ"/>
                                <Grid Grid.Row="1" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="VolBigText" Text="50%" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource IslandFont}"
                                               Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="60"/>
                                    <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource CustomSlider}" Value="50" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Button x:Name="MuteBtn" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE767;" Click="MuteBtn_Click"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border x:Name="TileShelf" Style="{StaticResource TileBorder}" Grid.Column="2" Grid.Row="1" Grid.ColumnSpan="2" MouseLeftButtonUp="TileShelf_Click">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource TileTitle}" Text="ПОЛКА ФАЙЛОВ"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="ShelfStack"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border x:Name="TileOut" Style="{StaticResource TileBorder}" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" MouseLeftButtonUp="TileOut_Click">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource TileTitle}" Text="УСТРОЙСТВА ВЫВОДА"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="DeviceStack"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border x:Name="TileSys" Style="{StaticResource TileBorder}" Grid.Column="2" Grid.Row="2" Grid.ColumnSpan="2" MouseLeftButtonUp="TileSys_Click">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource TileTitle}" Text="СИСТЕМА"/>
                                <Grid Grid.Row="1" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="CPU" FontSize="9" Foreground="{DynamicResource TextFaint}" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="SysCpuText" Text="0%" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource IslandFont}" Foreground="{DynamicResource Azure}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="RAM" FontSize="9" Foreground="{DynamicResource TextFaint}" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="SysRamText" Text="0%" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource IslandFont}" Foreground="{DynamicResource Amber}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border x:Name="TileNotif" Style="{StaticResource TileBorder}" Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="4" MouseLeftButtonUp="TileNotif_Click">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="УВЕДОМЛЕНИЯ" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NotifTileCount" Grid.Column="1" Text="нет новых" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel x:Name="NotifTileStack" Grid.Row="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border x:Name="VpnTileBorder" Style="{StaticResource TileBorder}" Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2" MouseLeftButtonUp="VpnTile_Click">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="VpnIcon" Text="⏻" FontSize="18" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock x:Name="VpnStatusText" Text="Выкл" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock x:Name="VpnDetailsText" Text="подключить" FontSize="9.5" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="TileQuick" Style="{StaticResource TileBorder}" Grid.Column="2" Grid.Row="4" Grid.ColumnSpan="2" Cursor="Arrow">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="QuickPin"   Grid.Column="0" Style="{StaticResource ChipButton}" Content="📌" Height="34" ToolTip="Закрепить остров" Margin="0,0,3,0" Click="QuickPin_Click"/>
                                <Button x:Name="QuickShot"  Grid.Column="1" Style="{StaticResource ChipButton}" Content="📸" Height="34" ToolTip="Снимок экрана" Margin="3,0,3,0" Click="QuickShot_Click"/>
                                <Button x:Name="QuickDev"   Grid.Column="2" Style="{StaticResource ChipButton}" Content="🔁" Height="34" ToolTip="Сменить аудиовыход" Margin="3,0,3,0" Click="QuickDev_Click"/>
                                <Button x:Name="QuickDnd"   Grid.Column="3" Style="{StaticResource ChipButton}" Content="🌙" Height="34" ToolTip="Не беспокоить" Margin="3,0,3,0" Click="QuickDnd_Click"/>
                                <Button x:Name="QuickGlass" Grid.Column="4" Style="{StaticResource ChipButton}" Content="🎨" Height="34" ToolTip="Стекло и подсветка" Margin="3,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- ==================== ФОКУС-ПАНЕЛИ ==================== -->

                        <Border x:Name="MixerPanel" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="4" Grid.RowSpan="5"
                                Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Hair}" BorderThickness="1"
                                CornerRadius="12" Padding="14" Visibility="Collapsed" Margin="4"
                                MouseRightButtonUp="Panel_MouseRightButtonUp">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Микшер громкости" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource IslandFont}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="← Назад" Style="{StaticResource ChipButton}" Click="MixerCloseBtn_Click"/>
                                </Grid>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,9">
                                    <Button Content="🎮 Игры"   Style="{StaticResource ChipButton}" Margin="0,0,5,0" Click="PresetGames_Click"/>
                                    <Button Content="💼 Работа" Style="{StaticResource ChipButton}" Margin="0,0,5,0" Click="PresetWork_Click"/>
                                    <Button Content="🍿 Кино"   Style="{StaticResource ChipButton}" Click="PresetMovie_Click"/>
                                </StackPanel>
                                <TextBox x:Name="MixerSearchBox" Grid.Row="2" Style="{StaticResource SearchBox}" Margin="0,0,0,9" TextChanged="MixerSearchBox_TextChanged"/>
                                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="AppVolumeStack"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border x:Name="MediaPanel" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="4" Grid.RowSpan="5"
                                Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Hair}" BorderThickness="1"
                                CornerRadius="12" Padding="0" Visibility="Collapsed" Margin="4" ClipToBounds="True"
                                MouseRightButtonUp="Panel_MouseRightButtonUp">
                            <Grid>
                                <Image x:Name="MediaBlurredCover" Stretch="UniformToFill" Opacity="0.34" IsHitTestVisible="False">
                                    <Image.Effect>
                                        <BlurEffect Radius="48"/>
                                    </Image.Effect>
                                </Image>
                                <Rectangle Fill="{DynamicResource Scrim}" IsHitTestVisible="False"/>
                                <Grid Margin="16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Сейчас играет" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource IslandFont}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="← Назад" Style="{StaticResource ChipButton}" Click="MediaCloseBtn_Click"/>
                                    </Grid>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="MediaLargeCover" Width="140" Height="140" CornerRadius="10" Background="#663A3A44"
                                                    Margin="0,0,16,0" VerticalAlignment="Top" Effect="{StaticResource SoftShadow}">
                                                <TextBlock x:Name="MediaLargeCoverText" Text="🎵" FontSize="54" FontFamily="{StaticResource EmojiFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock x:Name="MediaLargeTitle" Text="Нет трека" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource IslandFont}" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="MediaLargeArtist" Text="" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,12" TextTrimming="CharacterEllipsis"/>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="MediaCurrentTime" Text="0:00" FontSize="10" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" Margin="0,0,8,0"/>
