                                                                 Foreground="{DynamicResource AccentColor}" Background="{DynamicResource Track}" BorderThickness="0"
                                                                 Cursor="Hand" ToolTip="Клик — перемотать" MouseLeftButtonUp="MediaProgress_Click"/>
                                                    <TextBlock x:Name="MediaTotalTime" Grid.Column="2" Text="0:00" FontSize="10" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <Button x:Name="ShuffleBtn" Style="{StaticResource ChipButton}" Content="🔀" Width="34" ToolTip="Перемешать" Margin="0,0,5,0" Click="ShuffleBtn_Click"/>
                                                    <Button x:Name="RepeatBtn"  Style="{StaticResource ChipButton}" Content="🔁" Width="34" ToolTip="Повтор" Margin="0,0,10,0" Click="RepeatBtn_Click"/>
                                                    <Button x:Name="MediaPrevBtn" Style="{StaticResource MediaButton}" Width="40" Height="40" FontSize="16" Content="&#xE892;" Click="Prev_Click" Margin="0,0,6,0"/>
                                                    <Button x:Name="MediaPlayPauseBtn" Style="{StaticResource MediaButton}" Width="44" Height="44" FontSize="18" Content="&#xE768;" Click="PlayPause_Click" Margin="0,0,6,0"/>
                                                    <Button x:Name="MediaNextBtn" Style="{StaticResource MediaButton}" Width="40" Height="40" FontSize="16" Content="&#xE893;" Click="Next_Click" Margin="0,0,12,0"/>
                                                    <Button x:Name="OpenAppBtn" Style="{StaticResource ChipButton}" Content="📱 Открыть" Click="OpenAppBtn_Click"/>
                                                </StackPanel>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Громкость приложения" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <Slider x:Name="AppVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" Style="{StaticResource CustomSlider}" ValueChanged="AppVolumeSlider_ValueChanged"/>
                                                    <TextBlock x:Name="AppVolumeText" Grid.Column="2" Text="100%" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center" Margin="9,0,0,0" MinWidth="38" TextAlignment="Right"/>
                                                </Grid>
                                                <TextBlock Text="АКТИВНЫЕ СЕССИИ" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}" Margin="0,0,0,6"/>
                                                <StackPanel x:Name="MediaSessionsStack"/>
                                                <TextBlock Text="ИСТОРИЯ" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}" Margin="0,12,0,6"/>
                                                <StackPanel x:Name="TrackHistoryStack"/>
                                            </StackPanel>
                                        </Grid>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border x:Name="ClipboardPanel" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="4" Grid.RowSpan="5"
                                Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Hair}" BorderThickness="1"
                                CornerRadius="12" Padding="14" Visibility="Collapsed" Margin="4"
                                MouseRightButtonUp="Panel_MouseRightButtonUp">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Буфер обмена" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource IslandFont}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="← Назад" Style="{StaticResource ChipButton}" Click="ClipboardCloseBtn_Click"/>
                                </Grid>
                                <TextBox x:Name="ClipboardSearchBox" Grid.Row="1" Style="{StaticResource SearchBox}" Margin="0,0,0,9" TextChanged="ClipboardSearchBox_TextChanged"/>
                                <StackPanel x:Name="ClipChips" Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,9">
                                    <Button Content="Все"        Style="{StaticResource ChipButton}" Margin="0,0,5,0" Click="FilterClip_Click" Tag="all"/>
                                    <Button Content="📝 Текст"    Style="{StaticResource ChipButton}" Margin="0,0,5,0" Click="FilterClip_Click" Tag="text"/>
                                    <Button Content="🖼 Картинки" Style="{StaticResource ChipButton}" Margin="0,0,5,0" Click="FilterClip_Click" Tag="image"/>
                                    <Button Content="🎨 Цвета"    Style="{StaticResource ChipButton}" Margin="0,0,5,0" Click="FilterClip_Click" Tag="color"/>
                                    <Button Content="🔗 Ссылки"   Style="{StaticResource ChipButton}" Click="FilterClip_Click" Tag="url"/>
                                </StackPanel>
                                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="ClipboardLargeStack"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border x:Name="ShelfPanel" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="4" Grid.RowSpan="5"
                                Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Hair}" BorderThickness="1"
                                CornerRadius="12" Padding="14" Visibility="Collapsed" Margin="4"
                                MouseRightButtonUp="Panel_MouseRightButtonUp">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Полка файлов" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource IslandFont}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="← Назад" Style="{StaticResource ChipButton}" Click="ShelfCloseBtn_Click"/>
                                </Grid>
                                <TextBox x:Name="ShelfSearchBox" Grid.Row="1" Style="{StaticResource SearchBox}" Margin="0,0,0,9" TextChanged="ShelfSearchBox_TextChanged"/>
                                <StackPanel x:Name="ShelfChips" Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,9">
                                    <Button Content="📅 Дата"      Style="{StaticResource ChipButton}" Margin="0,0,5,0" Click="SortShelf_Click" Tag="date"/>
                                    <Button Content="🔤 Имя"       Style="{StaticResource ChipButton}" Margin="0,0,5,0" Click="SortShelf_Click" Tag="name"/>
                                    <Button Content="📦 Размер"    Style="{StaticResource ChipButton}" Margin="0,0,5,0" Click="SortShelf_Click" Tag="size"/>
                                    <Button Content="🖼 Картинки"  Style="{StaticResource ChipButton}" Click="FilterShelf_Click" Tag="image"/>
                                </StackPanel>
                                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                                    <WrapPanel x:Name="ShelfLargeGrid"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border x:Name="AudioPanel" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="4" Grid.RowSpan="5"
                                Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Hair}" BorderThickness="1"
                                CornerRadius="12" Padding="14" Visibility="Collapsed" Margin="4"
                                MouseRightButtonUp="Panel_MouseRightButtonUp">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Устройства вывода" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource IslandFont}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="← Назад" Style="{StaticResource ChipButton}" Click="AudioCloseBtn_Click"/>
                                </Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="DeviceLargeStack"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border x:Name="SystemPanel" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="4" Grid.RowSpan="5"
                                Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Hair}" BorderThickness="1"
                                CornerRadius="12" Padding="14" Visibility="Collapsed" Margin="4"
                                MouseRightButtonUp="Panel_MouseRightButtonUp">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Системный монитор" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource IslandFont}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="← Назад" Style="{StaticResource ChipButton}" Click="SystemCloseBtn_Click"/>
                                </Grid>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="🧹 Освободить RAM" Style="{StaticResource ChipButton}" Margin="0,0,5,0" Click="FreeRam_Click"/>
                                    <Button Content="☀️ Яркость"        Style="{StaticResource ChipButton}" Margin="0,0,5,0" Click="BrightnessBtn_Click"/>
                                    <Button Content="🌙 Ночной свет"    Style="{StaticResource ChipButton}" Click="NightLightBtn_Click"/>
                                </StackPanel>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,7,0">
                                        <StackPanel>
                                            <TextBlock Text="ТОП CPU" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}" Margin="0,0,0,6"/>
                                            <StackPanel x:Name="CpuProcessStack"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="7,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="ТОП RAM" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}" Margin="0,0,0,6"/>
                                            <StackPanel x:Name="RamProcessStack"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- ЦЕНТР УВЕДОМЛЕНИЙ -->
                        <Border x:Name="NotifPanel" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="4" Grid.RowSpan="5"
                                Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Hair}" BorderThickness="1"
                                CornerRadius="12" Padding="14" Visibility="Collapsed" Margin="4"
                                MouseRightButtonUp="Panel_MouseRightButtonUp">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Центр уведомлений" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource IslandFont}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <Button x:Name="NotifBackBtn" Grid.Column="1" Content="← Назад" Style="{StaticResource ChipButton}"/>
                                </Grid>
                                <Border x:Name="NotifAccessBar" Grid.Row="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10"
                                        Background="#22FFB020" BorderBrush="#55FFB020" BorderThickness="1" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="NotifAccessText" Text="Проверка доступа…" FontSize="10.5" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Button x:Name="NotifAccessBtn" Grid.Column="1" Content="Разрешить доступ" Style="{StaticResource ChipButton}"/>
                                    </Grid>
                                </Border>
                                <TextBox x:Name="NotifSearchBox" Grid.Row="2" Style="{StaticResource SearchBox}" Margin="0,0,0,10"/>
                                <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                                    <StackPanel x:Name="NotifChips" Orientation="Horizontal"/>
                                </ScrollViewer>
                                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="NotifReadAllBtn" Content="✓ Прочитать все" Style="{StaticResource ChipButton}" Margin="0,0,6,0"/>
                                    <Button x:Name="NotifClearBtn" Content="🗑 Очистить" Style="{StaticResource ChipButton}"/>
                                </StackPanel>
                                <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="NotifListStack"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- СТЕКЛО И ПОДСВЕТКА -->
                        <Border x:Name="GlassPanel" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="4" Grid.RowSpan="5"
                                Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Hair}" BorderThickness="1"
                                CornerRadius="12" Padding="14" Visibility="Collapsed" Margin="4"
                                MouseRightButtonUp="Panel_MouseRightButtonUp">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Стекло и подсветка" FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource IslandFont}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <Button x:Name="GlassCloseBtn" Grid.Column="1" Content="← Назад" Style="{StaticResource ChipButton}"/>
                                </Grid>

                                <Border Grid.Row="1" Height="46" CornerRadius="10" Margin="0,0,0,12"
                                        Background="{DynamicResource IslandBgGrad}" BorderBrush="{DynamicResource Hair}" BorderThickness="1">
                                    <Grid Margin="10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="GlPreview" Width="86" Height="28" CornerRadius="8"
                                                Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource HairHover}" BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="плитка" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="наведи курсор на плитку — она увеличится и засветится"
                                                   FontSize="10.5" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" Margin="12,0,10,0" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="14" Height="14" CornerRadius="3" Background="{DynamicResource AccentColor}" Margin="0,0,4,0"/>
                                            <Border Width="14" Height="14" CornerRadius="3" Background="{DynamicResource Lime}" Margin="0,0,4,0"/>
                                            <Border Width="14" Height="14" CornerRadius="3" Background="{DynamicResource Amber}" Margin="0,0,4,0"/>
                                            <Border Width="14" Height="14" CornerRadius="3" Background="{DynamicResource Coral}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="ПРОЗРАЧНОСТЬ" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                                            <Grid Margin="0,0,0,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="96"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="42"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Остров" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                <Slider x:Name="GlIsland" Grid.Column="1" Style="{StaticResource CustomSlider}" Minimum="55" Maximum="100" Value="82"/>
                                                <TextBlock x:Name="GlIslandV" Grid.Column="2" Text="82%" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" TextAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="96"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="42"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Панели" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                <Slider x:Name="GlPanel" Grid.Column="1" Style="{StaticResource CustomSlider}" Minimum="70" Maximum="100" Value="93"/>
                                                <TextBlock x:Name="GlPanelV" Grid.Column="2" Text="93%" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" TextAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="96"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="42"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Плитки" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                <Slider x:Name="GlTile" Grid.Column="1" Style="{StaticResource CustomSlider}" Minimum="12" Maximum="72" Value="40"/>
                                                <TextBlock x:Name="GlTileV" Grid.Column="2" Text="40%" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" TextAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="96"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="42"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Обводка" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                <Slider x:Name="GlStroke" Grid.Column="1" Style="{StaticResource CustomSlider}" Minimum="0" Maximum="30" Value="10"/>
                                                <TextBlock x:Name="GlStrokeV" Grid.Column="2" Text="1.0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" TextAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Text="ФОРМА" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" Margin="0,8,0,8"/>
                                            <Grid Margin="0,0,0,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="96"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="42"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Скругление" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                <Slider x:Name="GlRadius" Grid.Column="1" Style="{StaticResource CustomSlider}" Minimum="0" Maximum="28" Value="16"/>
                                                <TextBlock x:Name="GlRadiusV" Grid.Column="2" Text="16" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" TextAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="ПОДСВЕТКА ПРИ НАВЕДЕНИИ" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,8"/>
                                            <Grid Margin="0,0,0,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="96"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="42"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Увеличение" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                <Slider x:Name="GlHover" Grid.Column="1" Style="{StaticResource CustomSlider}" Minimum="100" Maximum="112" Value="103"/>
                                                <TextBlock x:Name="GlHoverV" Grid.Column="2" Text="103%" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" TextAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="96"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="42"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Свечение" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                <Slider x:Name="GlGlow" Grid.Column="1" Style="{StaticResource CustomSlider}" Minimum="0" Maximum="44" Value="20"/>
                                                <TextBlock x:Name="GlGlowV" Grid.Column="2" Text="20" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" TextAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="96"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="42"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Оттенок" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                <Slider x:Name="GlHue" Grid.Column="1" Style="{StaticResource CustomSlider}" Minimum="0" Maximum="360" Value="199"/>
                                                <TextBlock x:Name="GlHueV" Grid.Column="2" Text="199°" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" TextAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="96"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="42"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Скорость" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                <Slider x:Name="GlSpeed" Grid.Column="1" Style="{StaticResource CustomSlider}" Minimum="40" Maximum="200" Value="100"/>
                                                <TextBlock x:Name="GlSpeedV" Grid.Column="2" Text="1.0×" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" TextAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Text="СЛОИ" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" Margin="0,8,0,8"/>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox x:Name="GlSheen" Style="{StaticResource GlassCheck}" Content="Блик" IsChecked="True" Margin="0,0,14,0"/>
                                                <CheckBox x:Name="GlShadow" Style="{StaticResource GlassCheck}" Content="Тень" IsChecked="True" Margin="0,0,14,0"/>
                                                <CheckBox x:Name="GlEdge" Style="{StaticResource GlassCheck}" Content="Неон-край" IsChecked="True"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>

                                <Border Grid.Row="3" Height="1" Background="{DynamicResource Hair}" Margin="0,12,0,10"/>

                                <StackPanel Grid.Row="4" Orientation="Horizontal">
                                    <Button x:Name="GlReset"     Content="↺ Сброс"           Style="{StaticResource ChipButton}" Margin="0,0,6,0"/>
                                    <Button x:Name="GlRand"      Content="🎲 Случайно"       Style="{StaticResource ChipButton}" Margin="0,0,6,0"/>
                                    <Button x:Name="GlSysAccent" Content="🪟 Акцент Windows" Style="{StaticResource ChipButton}" Margin="0,0,6,0"/>
                                    <Button x:Name="GlExport"    Content="⬇ Экспорт XAML"    Style="{StaticResource ChipButton}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>