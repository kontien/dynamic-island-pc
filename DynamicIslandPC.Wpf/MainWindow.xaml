<Window x:Class="DynamicIslandPC.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island PC"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="800" Height="600" WindowStartupLocation="Manual"
        AllowDrop="True" FontFamily="Segoe UI Variable Display, Segoe UI"
        RenderOptions.BitmapScalingMode="HighQuality"
        DragOver="Window_DragOver" Drop="Window_Drop">

    <Window.Resources>
        <Color x:Key="Cyan">#22D3EE</Color>
        <Color x:Key="Violet">#A78BFA</Color>
        <Color x:Key="Success">#34D399</Color>
        <Color x:Key="Warning">#F59E0B</Color>
        <Color x:Key="Danger">#EF4444</Color>
        <Color x:Key="Info">#66C0F4</Color>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="Surface" Color="#B3111827"/>
        <SolidColorBrush x:Key="SurfaceHover" Color="#CC1E293B"/>
        <SolidColorBrush x:Key="Stroke" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="AccentColor" Color="{StaticResource Cyan}"/>
        <SolidColorBrush x:Key="AccentGlow" Color="#3322D3EE"/>
        <Color x:Key="AccentColorValue">#22D3EE</Color>

        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#22D3EE" Offset="0"/>
            <GradientStop Color="#A78BFA" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="IslandBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F41B2438" Offset="0"/>
            <GradientStop Color="#F40D1424" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="IslandStroke" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#38FFFFFF" Offset="0"/>
            <GradientStop Color="#12FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="VpnOnGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#34D399" Offset="0"/>
            <GradientStop Color="#059669" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="VpnOffGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#273349" Offset="0"/>
            <GradientStop Color="#141C2E" Offset="1"/>
        </LinearGradientBrush>

        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>
        <Style x:Key="FluentIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        </Style>

        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Аудио-пилюли: hover БЕЗ scale → никогда не выходят за границы -->
        <Style x:Key="AudioPillButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,12,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource SurfaceHover}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#5522D3EE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E60B1220"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MediaButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="12" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2422D3EE"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#3322D3EE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="6" CornerRadius="3" Background="#26334A"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" CornerRadius="3" Background="{StaticResource AccentGradient}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="18" Height="18">
                                                    <Ellipse Fill="#22D3EE" Opacity="0.25"/>
                                                    <Ellipse Width="12" Height="12" Fill="#F8FAFC"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                            <Grid>
                                <Rectangle x:Name="PART_Track" Fill="Transparent"/>
                                <Rectangle x:Name="PART_Indicator" Fill="{StaticResource AccentGradient}" HorizontalAlignment="Left" RadiusX="3" RadiusY="3"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="th" CornerRadius="4" Background="#334155" Margin="2,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="th" Property="Background" Value="#475569"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="th" Property="Background" Value="{StaticResource AccentGradient}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#F20D1424"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="5">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="9" Padding="12,8" Margin="2,1">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2222D3EE"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#1AFFFFFF"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <Grid x:Name="IslandContainer" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0">
            <Border x:Name="IslandBorder" Width="320" Height="48" CornerRadius="24"
                    Background="{StaticResource IslandBg}" BorderBrush="{StaticResource IslandStroke}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="4" Opacity="0.32"/>
                </Border.Effect>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Очистить буфер" Click="MenuClearClipboard_Click"/>
                        <MenuItem Header="Очистить полку" Click="MenuClearShelf_Click"/>
                        <Separator/>
                        <MenuItem Header="Выход" Foreground="#EF4444" Click="MenuExit_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ШАПКА -->
                    <Grid x:Name="TopPanel" Grid.Row="0" Height="48" Margin="20,0,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox x:Name="ClockViewbox" Stretch="Uniform" Height="30" HorizontalAlignment="Left">
                                    <TextBlock x:Name="ClockText" Text="00:00" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                </Viewbox>
                                <StackPanel x:Name="CountersPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Border Width="1" Height="16" Background="#26FFFFFF" Margin="0,0,12,0"/>
                                    <Border x:Name="CapsBadge" Background="#26F59E0B" CornerRadius="6" Padding="6,2" Margin="0,0,8,0" Visibility="Collapsed">
                                        <TextBlock x:Name="CapsText" Text="CAPS" FontSize="9" FontWeight="Bold" Foreground="#F59E0B"/>
                                    </Border>
                                    <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE8B7;" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,4,0"/>
                                    <TextBlock x:Name="ShelfCountText" Text="0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,10,0" Visibility="Collapsed"/>
                                    <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE8C8;" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,4,0"/>
                                    <TextBlock x:Name="ClipboardCountText" Text="0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,10,0" Visibility="Collapsed"/>
                                    <TextBlock x:Name="VpnIndicatorText" Style="{StaticResource FluentIcon}" Text="&#xE72E;" FontSize="12" Foreground="#34D399" Visibility="Collapsed"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="DatePanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,0,0" Opacity="0" Visibility="Collapsed">
                                <TextBlock x:Name="DateText" Text="" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE765;" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="10,0,4,0"/>
                                <TextBlock x:Name="LayoutText" Text="EN" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentColor}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox x:Name="CpuViewbox" Width="24" Height="24" Margin="0,0,8,0">
                                <Grid Width="48" Height="48">
                                    <Ellipse Stroke="#26334A" StrokeThickness="4"/>
                                    <Ellipse x:Name="CpuRing" Stroke="#22D3EE" StrokeThickness="4" StrokeDashArray="37.7" StrokeDashOffset="37.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-90" CenterX="24" CenterY="24"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <TextBlock x:Name="BigCpuValue" Text="0" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Viewbox>
                            <Viewbox x:Name="RamViewbox" Width="24" Height="24" Margin="0,0,8,0">
                                <Grid Width="48" Height="48">
                                    <Ellipse Stroke="#26334A" StrokeThickness="4"/>
                                    <Ellipse x:Name="RamRing" Stroke="#A78BFA" StrokeThickness="4" StrokeDashArray="37.7" StrokeDashOffset="37.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-90" CenterX="24" CenterY="24"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <TextBlock x:Name="BigRamValue" Text="0" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Viewbox>
                            <Viewbox x:Name="GpuViewbox" Width="24" Height="24">
                                <Grid Width="48" Height="48">
                                    <Ellipse Stroke="#26334A" StrokeThickness="4"/>
                                    <Ellipse x:Name="GpuRing" Stroke="#34D399" StrokeThickness="4" StrokeDashArray="37.7" StrokeDashOffset="37.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-90" CenterX="24" CenterY="24"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <TextBlock x:Name="BigGpuValue" Text="0" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Viewbox>
                        </StackPanel>
                    </Grid>

                    <!-- OSD: метрики 1-в-1 как у шапки (те же отступы, соразмерные иконка/проценты) -->
                    <Grid x:Name="OsdGrid" Grid.Row="0" Visibility="Collapsed" VerticalAlignment="Center"
                          MouseLeftButtonUp="OsdGrid_MouseLeftButtonUp" Cursor="Hand">
                        <!-- Свернутый: строка 48, иконка 30 (как часы), проценты 18 -->
                        <Grid x:Name="SmallOsd" Height="48" Margin="20,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="10" Background="#2222D3EE" Margin="0,0,12,0">
                                <TextBlock x:Name="SmallOsdIcon" Style="{StaticResource FluentIcon}" Text="&#xE767;" FontSize="15" Foreground="{StaticResource AccentColor}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock x:Name="SmallOsdAppName" Text="Система" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                                <ProgressBar x:Name="SmallOsdProgress" Minimum="0" Maximum="100" Value="50" Height="6" Background="#26334A" BorderThickness="0"/>
                            </StackPanel>
                            <TextBlock x:Name="SmallOsdPercentText" Grid.Column="2" Text="50%" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- Раскрытый: строка 78, иконка 48 (как кольца), проценты 36 (как часы) -->
                        <Grid x:Name="LargeOsd" Height="78" Margin="20,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="15" Background="#2222D3EE" Margin="0,0,18,0">
                                <TextBlock x:Name="LargeOsdIcon" Style="{StaticResource FluentIcon}" Text="&#xE767;" FontSize="22" Foreground="{StaticResource AccentColor}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock x:Name="LargeOsdAppName" Text="Система" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                                <ProgressBar x:Name="LargeOsdProgress" Minimum="0" Maximum="100" Value="50" Height="10" Background="#26334A" BorderThickness="0"/>
                            </StackPanel>
                            <TextBlock x:Name="LargeOsdPercentText" Grid.Column="2" Text="50%" FontSize="36" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>

                    <!-- ТАБ-БАР -->
                    <Border x:Name="TabBar" Grid.Row="1" Background="#660D1424" CornerRadius="14" Padding="4" Margin="20,2,20,12" Visibility="Collapsed" Opacity="0">
                        <Grid x:Name="TabGrid" SizeChanged="TabGrid_SizeChanged">
                            <Canvas>
                                <Border x:Name="TabPill" CornerRadius="10" Height="30" Width="125" Canvas.Top="0" Background="#2622D3EE" BorderBrush="#5522D3EE" BorderThickness="1">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Canvas>
                            <UniformGrid Rows="1" Columns="4">
                                <Button x:Name="SoundTabBtn" Style="{StaticResource TabButton}" Click="SoundTab_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE767;" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="Звук"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ClipboardTabBtn" Style="{StaticResource TabButton}" Click="ClipboardTab_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE8C8;" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="Буфер"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ShelfTabBtn" Style="{StaticResource TabButton}" Click="ShelfTab_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE8B7;" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="Полка"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="VpnTabBtn" Style="{StaticResource TabButton}" Click="VpnTab_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE72E;" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="VPN"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <!-- КОНТЕНТ -->
                    <Grid x:Name="TabContentGrid" Grid.Row="2" ClipToBounds="True" Background="Transparent" Margin="20,0,20,18"
                          Visibility="Collapsed" Opacity="0"
                          PreviewMouseLeftButtonDown="TabContent_PreviewDown" PreviewMouseMove="TabContent_PreviewMove" PreviewMouseLeftButtonUp="TabContent_PreviewUp">

                        <!-- SOUND: правая колонка с запасом, пилюли не выходят за край -->
                        <Grid x:Name="SoundTab" Visibility="Collapsed" ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="168"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <Border Background="{StaticResource Surface}" CornerRadius="16" Padding="12" Margin="0,0,0,14" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="PlayerCoverBorder" Width="50" Height="50" CornerRadius="13" Background="#26334A">
                                            <TextBlock x:Name="PlayerCoverText" Style="{StaticResource FluentIcon}" Text="&#xE8D6;" FontSize="22" Foreground="{StaticResource TextSecondary}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0">
                                            <TextBlock x:Name="PlayerTitleText" Text="Нет трека" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="PlayerArtistText" Text="YouTube / Spotify" FontSize="11" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="PrevBtn" Style="{StaticResource MediaButton}" Content="&#xE892;" Click="Prev_Click" Margin="0,0,2,0"/>
                                            <Button x:Name="PlayPauseBtn" Style="{StaticResource MediaButton}" Content="&#xE768;" Click="PlayPause_Click" Margin="0,0,2,0" FontSize="16" Background="#2622D3EE"/>
                                            <Button x:Name="NextBtn" Style="{StaticResource MediaButton}" Content="&#xE893;" Click="Next_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Grid Margin="4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="46"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE767;" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,0,12,0"/>
                                    <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource CustomSlider}" Value="50" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="VolumeValueText" Grid.Column="2" Text="50%" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentColor}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,2,0">
                                <Button x:Name="BtnAudioSpeakers" Style="{StaticResource AudioPillButton}" HorizontalAlignment="Stretch" MaxWidth="164" Click="BtnAudioSpeakers_Click"/>
                                <Button x:Name="BtnAudioHeadphones" Style="{StaticResource AudioPillButton}" HorizontalAlignment="Stretch" MaxWidth="164" Click="BtnAudioHeadphones_Click" Margin="0"/>
                            </StackPanel>
                        </Grid>

                        <!-- CLIPBOARD -->
                        <Grid x:Name="ClipboardTab" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="4,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="История буфера" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Очистить" Style="{StaticResource MediaButton}" Width="76" Height="24" FontSize="10" FontFamily="Segoe UI" Click="ClearClipboard_Click"/>
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                                <StackPanel x:Name="ClipboardStack"/>
                            </ScrollViewer>
                        </Grid>

                        <!-- SHELF -->
                        <Grid x:Name="ShelfTab" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Перетащи файлы сюда" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="4,0,0,10"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                                <StackPanel x:Name="ShelfStack"/>
                            </ScrollViewer>
                        </Grid>

                        <!-- VPN -->
                        <Grid x:Name="VpnTab" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource Surface}" CornerRadius="16" Padding="14,11" Margin="0,0,0,12" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="10" Background="#2234D399" Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE774;" FontSize="15" Foreground="#34D399"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Сервер" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock Text="Авто · Самый быстрый" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#2234D399" CornerRadius="9" Padding="8,4" VerticalAlignment="Center">
                                        <TextBlock Text="WIREGUARD" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <Viewbox Grid.Row="1" Stretch="Uniform" MaxWidth="150" MaxHeight="150" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="200" Height="200">
                                    <Ellipse x:Name="PulseRing1" Stroke="#4034D399" StrokeThickness="3" Opacity="0" RenderTransformOrigin="0.5,0.5"/>
                                    <Ellipse x:Name="PulseRing2" Stroke="#2034D399" StrokeThickness="3" Opacity="0" RenderTransformOrigin="0.5,0.5"/>
                                    <Button x:Name="VpnToggleBtn" Width="140" Height="140" Cursor="Hand" Click="VpnToggleBtn_Click" FocusVisualStyle="{x:Null}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid RenderTransformOrigin="0.5,0.5">
                                                    <Grid.RenderTransform>
                                                        <ScaleTransform x:Name="vsc" ScaleX="1" ScaleY="1"/>
                                                    </Grid.RenderTransform>
                                                    <Ellipse x:Name="BtnBg" Fill="{StaticResource VpnOffGradient}" Stroke="#33FFFFFF" StrokeThickness="2"/>
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="vsc" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetName="vsc" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="vsc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"/>
                                                                    <DoubleAnimation Storyboard.TargetName="vsc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock x:Name="VpnIcon" Style="{StaticResource FluentIcon}" Text="&#xE7E8;" FontSize="44" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock x:Name="VpnStatusText" Text="Выкл" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Viewbox>
                            <TextBlock x:Name="VpnDetailsText" Grid.Row="2" Text="Нажми, чтобы защитить соединение" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>