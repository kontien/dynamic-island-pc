<Window x:Class="DynamicIslandPC.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island PC"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="280" Height="44"
        WindowStartupLocation="Manual"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.Resources>
        <DropShadowEffect x:Key="IslandShadow" BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity="0.6"/>

        <LinearGradientBrush x:Key="GlassGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1E293B" Offset="0"/>
            <GradientStop Color="#0F172A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#22D3EE" Offset="0"/>
            <GradientStop Color="#A78BFA" Offset="1"/>
        </LinearGradientBrush>

        <!-- Стиль слайдера громкости (с градиентным заполнением и круглым thumb) -->
        <Style x:Key="CustomVolumeSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Трек (фон) -->
                            <Border x:Name="TrackBackground" Grid.Row="1" Height="6" CornerRadius="3" Background="#334155" VerticalAlignment="Center"/>
                            <!-- Заполнение (градиент) -->
                            <Border x:Name="PART_SelectionRange" Grid.Row="1" Height="6" CornerRadius="3" Background="{StaticResource AccentGradient}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <!-- Thumb -->
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="16" Height="16" Fill="{StaticResource AccentGradient}" Stroke="#FFFFFF" StrokeThickness="2" Cursor="Hand"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwapButton" TargetType="Button">
            <Setter Property="Foreground" Value="#22D3EE"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#22D3EE" Opacity="0.13" CornerRadius="13" BorderBrush="#22D3EE" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="IslandBorder" Background="{StaticResource GlassGradient}" CornerRadius="22" Effect="{StaticResource IslandShadow}" BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ХЕДЕР -->
            <Grid x:Name="HeaderGrid" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="14,0,0,0">
                    <TextBlock x:Name="ClockText" Text="12:00" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                    <TextBlock Text="  &#8226;  " FontSize="13" Foreground="#475569" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LayoutText" Text="RU" FontSize="13" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Column="1">
                    <TextBlock x:Name="CapsText" Text="CAPS" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="ShelfCountText" Text="&#128206; 0" FontSize="11" FontWeight="Bold" Foreground="#22D3EE" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="ClipboardCountText" Text="&#128203; 0" FontSize="11" FontWeight="Bold" Foreground="#A78BFA" VerticalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,14,0" Grid.Column="2">
                    <Border x:Name="CpuIndicator" Width="22" Height="22" CornerRadius="11" Background="#22D3EE" Margin="0,0,4,0" ToolTip="CPU">
                        <TextBlock x:Name="CpuIndicatorText" Text="0" FontSize="10" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="RamIndicator" Width="22" Height="22" CornerRadius="11" Background="#A78BFA" Margin="0,0,4,0" ToolTip="RAM">
                        <TextBlock x:Name="RamIndicatorText" Text="0" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="GpuIndicator" Width="22" Height="22" CornerRadius="11" Background="#F59E0B" Margin="0,0,0,0" ToolTip="GPU">
                        <TextBlock x:Name="GpuIndicatorText" Text="0" FontSize="10" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- OSD -->
            <Grid x:Name="OsdGrid" Grid.Row="0" Visibility="Collapsed">
                <Border Background="#CC111827" CornerRadius="22" BorderBrush="#FFFFFF" BorderThickness="1" Padding="16,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="20" Height="20" Fill="{StaticResource AccentGradient}" Margin="0,0,12,0"/>
                        <ProgressBar x:Name="OsdProgress" Grid.Column="1" Minimum="0" Maximum="100" Value="50" Height="8" Foreground="{StaticResource AccentGradient}" Background="#334155" BorderThickness="0" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock x:Name="OsdPercentText" Grid.Column="2" Text="50%" FontSize="14" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- РАСКРЫТАЯ ПАНЕЛЬ -->
            <Grid x:Name="ExpandedGrid" Grid.Row="1" Visibility="Collapsed" Margin="16,0,16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Rows="1" Columns="5">
                    <Button x:Name="SoundTabBtn" Style="{StaticResource TabButton}" Content="&#128266; Звук" Click="SoundTab_Click"/>
                    <Button x:Name="ShelfTabBtn" Style="{StaticResource TabButton}" Content="&#128206; Полка" Click="ShelfTab_Click"/>
                    <Button x:Name="ClipboardTabBtn" Style="{StaticResource TabButton}" Content="&#128203; Буфер" Click="ClipboardTab_Click"/>
                    <Button x:Name="PlayerTabBtn" Style="{StaticResource TabButton}" Content="&#9654; Плеер" Click="PlayerTab_Click"/>
                    <Button x:Name="SystemTabBtn" Style="{StaticResource TabButton}" Content="&#9881; Система" Click="SystemTab_Click"/>
                </UniformGrid>

                <Grid x:Name="TabContentGrid" Grid.Row="2"
                      PreviewMouseLeftButtonDown="TabContent_PreviewDown"
                      PreviewMouseMove="TabContent_PreviewMove"
                      PreviewMouseLeftButtonUp="TabContent_PreviewUp">

                    <!-- ЗВУК -->
                    <Grid x:Name="SoundTab" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="&#128266;  Громкость" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="2,0,0,6"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="VolumeSlider" Style="{StaticResource CustomVolumeSlider}" Value="50" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="VolumeValueText" Grid.Column="1" Text="50%" FontSize="16" FontWeight="Bold" Foreground="#22D3EE" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                        <Border Grid.Row="3" Background="#FFFFFF" Opacity="0.08" Height="1"/>
                        <TextBlock Grid.Row="5" Text="&#128268;  Устройство вывода" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="2,0,0,6"/>
                        <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                            <StackPanel x:Name="DevicesStack"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- ПОЛКА -->
                    <Grid x:Name="ShelfTab" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="&#128206;  Перетащи файлы сюда" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="2,0,0,6"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                            <StackPanel x:Name="ShelfStack"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- БУФЕР -->
                    <Grid x:Name="ClipboardTab" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="2,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#128203;  Буфер обмена" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="&#128465; Очистить" Style="{StaticResource IconButton}" Width="80" Height="24" FontSize="10" Click="ClearClipboard_Click"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                            <StackPanel x:Name="ClipboardStack"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- ПЛЕЕР -->
                    <Grid x:Name="PlayerTab" Visibility="Collapsed" AllowDrop="True" DragOver="Player_DragOver" Drop="Player_Drop">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#14FFFFFF" CornerRadius="8" Padding="8,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#128421; " FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ActiveWindowText" Text="Нет активного медиа" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                            </StackPanel>
                        </Border>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="10" Background="#1E293B" HorizontalAlignment="Left">
                                <TextBlock x:Name="PlayerCoverText" Text="&#127925;" FontSize="26" FontFamily="Segoe UI Emoji" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock x:Name="PlayerTitleText" Text="Нет трека" FontSize="13" FontWeight="Bold" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PlayerArtistText" Text="Брось mp3/wav сюда" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PlayerPosText" Text="0:00" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Slider x:Name="PlayerSeekSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PlayerDurText" Grid.Column="2" Text="0:00" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="ShuffleBtn" Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="13" Content="&#128256;" Click="Shuffle_Click"/>
                            <Button x:Name="PrevBtn" Style="{StaticResource IconButton}" Width="36" Height="36" FontSize="16" Content="&#9198;" Click="Prev_Click"/>
                            <Button x:Name="PlayPauseBtn" Style="{StaticResource IconButton}" Width="44" Height="44" FontSize="18" Content="&#9654;" Click="PlayPause_Click" Background="#22D3EE" Foreground="#0F172A"/>
                            <Button x:Name="NextBtn" Style="{StaticResource IconButton}" Width="36" Height="36" FontSize="16" Content="&#9197;" Click="Next_Click"/>
                            <Button x:Name="RepeatBtn" Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="13" Content="&#128257;" Click="Repeat_Click"/>
                        </StackPanel>
                        <Grid Grid.Row="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#128265;" FontSize="13" FontFamily="Segoe UI Emoji" VerticalAlignment="Center"/>
                            <Slider x:Name="PlayerVolSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="80" VerticalAlignment="Center" Margin="6,0"/>
                            <TextBlock x:Name="PlayerVolText" Grid.Column="2" Text="80%" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Grid.Row="10" Background="#FFFFFF" Opacity="0.08" Height="1"/>
                        <ScrollViewer Grid.Row="12" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                            <StackPanel x:Name="PlaylistStack"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- СИСТЕМА -->
                    <Grid x:Name="SystemTab" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#128187; Процессор" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                <TextBlock x:Name="CpuPercentText" Grid.Column="1" Text="0%" FontSize="13" FontWeight="Bold" Foreground="#22D3EE" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar x:Name="CpuProgressBar" Minimum="0" Maximum="100" Value="0" Height="8" Foreground="#22D3EE" Background="#334155" BorderThickness="0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#129504; Оперативная память" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                <TextBlock x:Name="RamText" Grid.Column="1" Text="0 / 0 ГБ" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="RamProgressBar" Minimum="0" Maximum="100" Value="0" Height="8" Foreground="#A78BFA" Background="#334155" BorderThickness="0"/>
                                <TextBlock x:Name="RamPercentText" Grid.Column="1" Text="0%" FontSize="13" FontWeight="Bold" Foreground="#A78BFA" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="4">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#127918; Видеокарта" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                <TextBlock x:Name="GpuPercentText" Grid.Column="1" Text="0%" FontSize="13" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar x:Name="GpuProgressBar" Minimum="0" Maximum="100" Value="0" Height="8" Foreground="#F59E0B" Background="#334155" BorderThickness="0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>