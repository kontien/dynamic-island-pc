<Window x:Class="DynamicIslandPC.Wpf.Views.ScreenshotOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор области"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Cursor="Cross"
        Focusable="True"
        FocusVisualStyle="{x:Null}"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">
    <Grid x:Name="Root"
          MouseLeftButtonDown="Root_MouseLeftButtonDown"
          MouseMove="Root_MouseMove"
          MouseLeftButtonUp="Root_MouseLeftButtonUp"
          MouseRightButtonDown="Root_MouseRightButtonDown">

        <!-- Замороженный снимок экрана -->
        <Image x:Name="FrozenImage" Stretch="Fill"/>

        <!-- Затемнение с вырезом под выделение -->
        <Canvas x:Name="DimCanvas" IsHitTestVisible="False">
            <Rectangle x:Name="DimTop" Fill="#99000000"/>
            <Rectangle x:Name="DimBottom" Fill="#99000000"/>
            <Rectangle x:Name="DimLeft" Fill="#99000000"/>
            <Rectangle x:Name="DimRight" Fill="#99000000"/>
        </Canvas>

        <Canvas x:Name="OverlayCanvas">
            <Line x:Name="CrossH" Stroke="#44FFFFFF" StrokeThickness="1" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Line x:Name="CrossV" Stroke="#44FFFFFF" StrokeThickness="1" Visibility="Collapsed" IsHitTestVisible="False"/>

            <Rectangle x:Name="SelectionRect" Stroke="#28E1F6" StrokeThickness="2" StrokeDashArray="4 2"
                       Fill="#00000000" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Rectangle x:Name="SelectionInner" Stroke="#FFFFFFFF" StrokeThickness="1"
                       Fill="Transparent" Visibility="Collapsed" IsHitTestVisible="False"/>

            <Canvas x:Name="HandlesCanvas" Visibility="Collapsed" IsHitTestVisible="False">
                <Ellipse x:Name="HandleTL" Width="10" Height="10" Fill="#28E1F6" Stroke="White" StrokeThickness="1.5"/>
                <Ellipse x:Name="HandleTR" Width="10" Height="10" Fill="#28E1F6" Stroke="White" StrokeThickness="1.5"/>
                <Ellipse x:Name="HandleBL" Width="10" Height="10" Fill="#28E1F6" Stroke="White" StrokeThickness="1.5"/>
                <Ellipse x:Name="HandleBR" Width="10" Height="10" Fill="#28E1F6" Stroke="White" StrokeThickness="1.5"/>
                <Ellipse x:Name="HandleT"  Width="10" Height="10" Fill="#28E1F6" Stroke="White" StrokeThickness="1.5"/>
                <Ellipse x:Name="HandleB"  Width="10" Height="10" Fill="#28E1F6" Stroke="White" StrokeThickness="1.5"/>
                <Ellipse x:Name="HandleL"  Width="10" Height="10" Fill="#28E1F6" Stroke="White" StrokeThickness="1.5"/>
                <Ellipse x:Name="HandleR"  Width="10" Height="10" Fill="#28E1F6" Stroke="White" StrokeThickness="1.5"/>
            </Canvas>

            <Border x:Name="InfoPanel" Background="#E00A1418" CornerRadius="6" Padding="10,5"
                    BorderBrush="#3328E1F6" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="SizeText" Foreground="#28E1F6" FontSize="11" FontFamily="Consolas" FontWeight="SemiBold"/>
                    <TextBlock x:Name="CoordsText" Foreground="#8B97A8" FontSize="11" FontFamily="Consolas" Margin="12,0,0,0"/>
                </StackPanel>
            </Border>

            <Border x:Name="MagnifierBorder" Width="122" Height="146" CornerRadius="8"
                    Background="#E00A1418" BorderBrush="#28E1F6" BorderThickness="1.5"
                    Visibility="Collapsed" IsHitTestVisible="False" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="122"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Image x:Name="MagnifierImage" Stretch="Fill" Margin="1"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <Line X1="61" Y1="0" X2="61" Y2="122" Stroke="#28E1F6" StrokeThickness="1" Opacity="0.5"/>
                    <Line X1="0" Y1="61" X2="122" Y2="61" Stroke="#28E1F6" StrokeThickness="1" Opacity="0.5"/>
                    <Border Grid.Row="1" Background="#0A1418" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0">
                        <TextBlock x:Name="MagnifierText" Foreground="#B6F24A" FontSize="10" FontFamily="Consolas"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <StackPanel x:Name="ActionPanel" Orientation="Horizontal" Visibility="Collapsed">
                <Button x:Name="ConfirmBtn" Content="✓ Снять (Enter)" Click="ConfirmBtn_Click"
                        Background="#28E1F6" Foreground="#071418" FontWeight="Bold"
                        FontSize="12" Padding="14,8" BorderThickness="0" Cursor="Hand"/>
                <Button x:Name="CancelBtn" Content="✕ Отмена" Click="CancelBtn_Click"
                        Background="#33FFFFFF" Foreground="White" FontWeight="SemiBold"
                        FontSize="12" Padding="14,8" Margin="8,0,0,0" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>

            <Border x:Name="HelpPanel" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Background="#E00A1418" CornerRadius="8" Padding="16,9" Margin="0,0,0,32"
                    BorderBrush="#1AFFFFFF" BorderThickness="1" IsHitTestVisible="False">
                <TextBlock Foreground="#F4F7FB" FontSize="12">
                    <Run Text="Выдели область мышью"/>
                    <Run Text="  ·  " Foreground="#5F6C80"/>
                    <Run Text="Enter" Foreground="#28E1F6" FontWeight="Bold"/>
                    <Run Text=" — снять"/>
                    <Run Text="  ·  " Foreground="#5F6C80"/>
                    <Run Text="Esc" Foreground="#FF5E6C" FontWeight="Bold"/>
                    <Run Text=" — отмена"/>
                </TextBlock>
            </Border>
        </Canvas>
    </Grid>
</Window>